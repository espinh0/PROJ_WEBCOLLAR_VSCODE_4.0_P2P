  function globalDispatchDelayMs(){
    return Math.max(0, parseInt(S.preDelayMs, 10) || 0);
  }
  function enqueue(task){
    queue.push({ task, dueAt: Date.now() + globalDispatchDelayMs() });
    if(!processing) runNext();
  }
  async function runNext(){
    if (processing) return;
    const item = queue.shift(); if (!item) return;
    processing = true;
    try {
      const waitMs = Math.max(0, (item.dueAt || 0) - Date.now());
      if (waitMs > 0) await delay(waitMs);
      await item.task();
    } catch(e){ console.warn('task erro', e); }
    processing = false;
    if (queue.length) runNext();
  }

  function buildPayload(text){
    const username = 'fs-remote';
