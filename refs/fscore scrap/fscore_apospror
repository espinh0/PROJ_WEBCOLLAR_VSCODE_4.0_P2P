    controlExecLedEl.classList.remove("led-on", "led-off", "led-gap", "led-warn");
    const cls = phase === "on" ? "led-on" : (phase === "warn" ? "led-warn" : (phase === "gap" ? "led-gap" : "led-off"));
    controlExecLedEl.classList.add(cls);
  }

  function resolveControlLedPhase(){
    if (controlLedCommands.size > 0) return "on";
    if (controlLedWarnings.size > 0) return "warn";
    if (controlLedGapSources.size > 0) return "gap";
    return "off";
  }

  function isControlExecBusy(){
    return resolveControlLedPhase() !== "off";
  }

  function emitControlExecState(){
    const phase = resolveControlLedPhase();
    window.__CONTROL_EXEC_ACTIVE__ = phase !== "off";
    try {
      window.dispatchEvent(new CustomEvent("control:exec_state", {
        detail: {
          active: phase !== "off",
          phase,
          commandCount: controlLedCommands.size,
          warningCount: controlLedWarnings.size,
          gapCount: controlLedGapSources.size,
          ts: Date.now()
        }
      }));
    } catch(_){}
  }

  function updateControlLed(){
    applyControlLedPhase(resolveControlLedPhase());
    emitControlExecState();
  }

  function beginControlCommand(source, ttlMs=200){
    const token = Symbol(String(source || "cmd"));
    const ms = Number(ttlMs) || 0;
    let timer = null;
    if (ms > 0) {
      timer = setTimeout(() => endControlCommand(token), Math.max(40, ms));
    }
    controlLedCommands.set(token, timer);
    updateControlLed();
    return token;
  }

  function endControlCommand(token){
    if (!controlLedCommands.has(token)) return;
    const timer = controlLedCommands.get(token);
    if (timer) clearTimeout(timer);
    controlLedCommands.delete(token);
    updateControlLed();
  }

  function beginControlWarning(source, ttlMs=700){
    const token = Symbol(String(source || "warn"));
    const ms = Number(ttlMs) || 0;
    let timer = null;
    if (ms > 0) {
      timer = setTimeout(() => endControlWarning(token), Math.max(80, ms));
    }
    controlLedWarnings.set(token, timer);
    updateControlLed();
    return token;
  }

  function endControlWarning(token){
    if (!controlLedWarnings.has(token)) return;
    const timer = controlLedWarnings.get(token);
    if (timer) clearTimeout(timer);
    controlLedWarnings.delete(token);
    updateControlLed();
  }

  function setControlLedGap(source){
    const key = String(source || "gap");
    controlLedGapSources.add(key);
    updateControlLed();
  }

  function clearControlLedGap(source){
