  function buildRampRuntimeSnapshot(reason){
    const session = rampSession;
    if (!session) {
      return {
        active: false,
        phase: "idle",
        currentLevel: 0,
        targetLevel: 0,
        progress: 0,
        mode: currentMode,
        channel,
        reason: reason || "idle"
      };
    }
    const now = Date.now();
    const upTotal = Math.max(0, Number(session.upDurationMs) || 0);
    const upElapsed = Math.max(0, now - (session.upStartAt || now));
    const upProgress = upTotal <= 0 ? 1 : clampNum(upElapsed / upTotal, 0, 1);
    if (session.phase === "down") {
      const total = Math.max(0, Number(session.downDurationMs) || 0);
      const elapsed = Math.max(0, now - (session.downStartAt || now));
      const downProgress = total <= 0 ? 1 : clampNum(elapsed / total, 0, 1);
      const base = clampNum(Number(session.releaseBaseProgress) || 0, 0, 1);
      const progress = base + ((1 - base) * downProgress);
      return {
        active: true,
        phase: "down",
        currentLevel: clampNum(Math.round(Number(session.currentLevel) || 0), 0, 100),
        targetLevel: 0,
