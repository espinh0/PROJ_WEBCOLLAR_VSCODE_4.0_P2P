    function log(line) {
      if (!logEl) return;
      const ts = new Date().toLocaleTimeString();
      logEl.textContent += `[${ts}] ${line}\n`;
      logEl.scrollTop = logEl.scrollHeight;
    }

    const textEncoder = (typeof TextEncoder !== 'undefined') ? new TextEncoder() : null;
    let bytesSent = 0;
    let bytesRecv = 0;
    let lastBytesSent = 0;
    let lastBytesRecv = 0;
    let bandwidthTimer = null;

    function estimateBytes(obj) {
      if (!obj) return 0;
      let str = '';
      try { str = JSON.stringify(obj); } catch { return 0; }
      if (!str) return 0;
      if (textEncoder) return textEncoder.encode(str).length;
      try { return unescape(encodeURIComponent(str)).length; } catch { return str.length; }
    }

    function formatBytes(bytes) {
      const units = ['B', 'KB', 'MB', 'GB'];
      let val = Math.max(0, Number(bytes) || 0);
      let idx = 0;
      while (val >= 1024 && idx < units.length - 1) {
        val /= 1024;
        idx += 1;
      }
      const decimals = (idx === 0 || val >= 10) ? 0 : 1;
      return `${val.toFixed(decimals)} ${units[idx]}`;
    }

    function updateBandwidthLabel() {
      if (!bandwidthEl) return;
      const sentRate = bytesSent - lastBytesSent;
      const recvRate = bytesRecv - lastBytesRecv;
      lastBytesSent = bytesSent;
      lastBytesRecv = bytesRecv;
      bandwidthEl.innerHTML = `<i class="fa-solid fa-arrow-up"></i> ${formatBytes(bytesSent)} (${formatBytes(sentRate)}/s) / <i class="fa-solid fa-arrow-down"></i> ${formatBytes(bytesRecv)} (${formatBytes(recvRate)}/s)`;
    }

    function startBandwidthTimer() {
      if (bandwidthTimer) return;
      bandwidthTimer = setInterval(updateBandwidthLabel, 1000);
      updateBandwidthLabel();
    }

    function resetBandwidthCounters() {
      bytesSent = 0;
      bytesRecv = 0;
      lastBytesSent = 0;
      lastBytesRecv = 0;
      updateBandwidthLabel();
    }

    function trackSend(obj) {
      bytesSent += estimateBytes(obj);
