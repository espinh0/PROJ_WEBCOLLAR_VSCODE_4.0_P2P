  function normalizeAdvancedState(next){
    const target = next || advanced || { ...ADV_DEFAULTS };
    target.pulses = clampNum(Math.round(target.pulses || ADV_DEFAULTS.pulses), ADV_LIMITS.pulses.min, ADV_LIMITS.pulses.max);
    target.durationMs = clampNum(Math.round(target.durationMs || ADV_DEFAULTS.durationMs), ADV_LIMITS.durationMs.min, ADV_LIMITS.durationMs.max);
    target.delayMs = clampNum(Math.round(target.delayMs || ADV_DEFAULTS.delayMs), ADV_LIMITS.delayMs.min, ADV_LIMITS.delayMs.max);
    target.preDelayMs = clampNum(Math.round(target.preDelayMs || ADV_DEFAULTS.preDelayMs), ADV_LIMITS.preDelayMs.min, ADV_LIMITS.preDelayMs.max);
    return target;
  }
  function normalizeRampState(next){
    const target = { ...RAMP_DEFAULTS, ...(next || ramp || {}) };
    target.enabled = !!target.enabled;
    target.step = clampNum(Math.round(Number(target.step) || RAMP_DEFAULTS.step), RAMP_LIMITS.step.min, RAMP_LIMITS.step.max);
    target.tickMs = clampNum(Math.round(Number(target.tickMs) || RAMP_DEFAULTS.tickMs), RAMP_LIMITS.tickMs.min, RAMP_LIMITS.tickMs.max);
    target.startLevel = clampNum(Math.round(Number(target.startLevel) || 0), RAMP_LIMITS.startLevel.min, RAMP_LIMITS.startLevel.max);
    target.upCurve = RAMP_CURVES.has(target.upCurve) ? target.upCurve : RAMP_DEFAULTS.upCurve;
    target.downCurve = RAMP_CURVES.has(target.downCurve) ? target.downCurve : RAMP_DEFAULTS.downCurve;
