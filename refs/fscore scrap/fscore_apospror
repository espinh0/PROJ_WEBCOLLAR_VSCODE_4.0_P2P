      if (!merged.team) merged.anySide = true;
      if (!merged.side) merged.side = merged.anySide ? 'any' : 'home';
      if (merged.anySide && merged.side !== 'any') merged.side = 'any';
      return merged;
    }catch(_){
      return structuredClone(DEFAULTS);
    }
  }

