        hostIdTakenRecent: typeof isHostIdTakenRecently === 'function' ? isHostIdTakenRecently() : false,
        lastRoomHostId,
        activeHostId: activeHostId ? shortPeer(activeHostId) : '',
        hostIdIndex,
        hostConnectFailures,
