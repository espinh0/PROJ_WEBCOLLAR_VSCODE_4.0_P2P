  function applyRampPatch(payload, opts = {}){
    if (!payload || typeof payload !== "object") return;
    const hasRampPayload = (
      payload.rampEnabled != null ||
      payload.rampStep != null ||
      payload.rampTickMs != null ||
      payload.rampStartLevel != null ||
      payload.rampUpCurve != null ||
      payload.rampDownCurve != null ||
      payload.rampUpExponent != null ||
      payload.rampDownExponent != null
    );
    if (!hasRampPayload) return;
    const next = { ...ramp };
    let changed = false;
    if (payload.rampEnabled != null) {
      next.enabled = !!payload.rampEnabled;
      changed = true;
    }
    if (payload.rampStep != null && Number.isFinite(Number(payload.rampStep))) {
      next.step = Number(payload.rampStep);
      changed = true;
    }
    if (payload.rampTickMs != null && Number.isFinite(Number(payload.rampTickMs))) {
      next.tickMs = Number(payload.rampTickMs);
      changed = true;
    }
    if (payload.rampStartLevel != null && Number.isFinite(Number(payload.rampStartLevel))) {
      next.startLevel = Number(payload.rampStartLevel);
      changed = true;
    }
    if (payload.rampUpCurve && typeof payload.rampUpCurve === "string") {
      next.upCurve = payload.rampUpCurve;
      changed = true;
    }
    if (payload.rampDownCurve && typeof payload.rampDownCurve === "string") {
      next.downCurve = payload.rampDownCurve;
      changed = true;
    }
    if (payload.rampUpExponent != null && Number.isFinite(Number(payload.rampUpExponent))) {
      next.upExponent = Number(payload.rampUpExponent);
      changed = true;
    }
    if (payload.rampDownExponent != null && Number.isFinite(Number(payload.rampDownExponent))) {
      next.downExponent = Number(payload.rampDownExponent);
      changed = true;
    }
    if (!changed) {
      if (opts.syncWidget !== false) syncRampWidgetState(opts.reason || "ramp-sync");
      return;
    }
    ramp = normalizeRampState(next);
    if (!ramp.enabled && rampSession) {
      abortRampSession({ sendHoldOff: true });
    }
    if (opts.persist !== false) persistState();
    if (opts.syncWidget !== false) syncRampWidgetState(opts.reason || "ramp-sync");
    if (opts.broadcast !== false) emitControlPatch(buildRampPatch(opts.reason || "ramp-change"));
  }

