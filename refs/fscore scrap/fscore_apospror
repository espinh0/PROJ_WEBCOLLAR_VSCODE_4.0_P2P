  }

  async function fireResultRule(eventKey, sideKey){
    if (!S.armed) {
      appendLog(`Ignorado (desarmado): resultado/${eventKey}`, 'fs-remote');
      return;
    }
    const rule = S.resultRules?.[eventKey];
    if (!rule || !rule.enabled) return;
    if (!resultTargetMatches(rule, sideKey, eventKey)) return;
    const mode = String(rule.mode || '').toUpperCase();
    const pulses = Math.max(1, parseInt(rule.pulses, 10) || 1);
    const gap = Math.max(0, parseInt(rule.gapMs, 10) || 0);
    appendLog(`Resultado ${eventKey} (${labelForTargetSide(sideKey)}): ${mode || 'SHOCK'} x${pulses}`, 'fs-remote');
    if (mode === 'ROULETTE') {
      for (let i = 0; i < pulses; i++) {
        await spinRouletteOnce();
        if (i < pulses - 1) await delay(gap);
      }
      return;
    }
    for (let i = 0; i < pulses; i++) {
      await pulseRule(rule);
      if (i < pulses - 1) await delay(gap);
    }
  }

  // Usa a ponte exposta pelo maincontrol para disparar o botão da roleta
  async function spinRouletteOnce(){
    return new Promise(resolve => {
      const bridge = window.__ROULETTE_BRIDGE__;
      const forwardEvent = bridge && typeof bridge.forwardEvent === 'function' ? bridge.forwardEvent : null;
      const rouletteButton = document.getElementById('r3Btn');
      if (!forwardEvent && !rouletteButton) {
        appendLog('Roleta indisponível (#r3Btn não encontrado).', 'fs-remote');
        resolve();
        return;
      }

      const triggerEvent = (type) => {
        if (forwardEvent) {
          try { return forwardEvent(type); } catch(_) { return false; }
        }
        if (!rouletteButton) return false;
        try {
          return rouletteButton.dispatchEvent(new PointerEvent(type, { bubbles: true }));
        } catch(_){
          return rouletteButton.dispatchEvent(new Event(type, { bubbles: true }));
        }
      };

      let done = false;
      let releaseTimer = null;
      let failSafeTimer = null;

      const cleanup = () => {
        window.removeEventListener('roulette:finished', finishListener);
        if (releaseTimer) clearTimeout(releaseTimer);
        if (failSafeTimer) clearTimeout(failSafeTimer);
      };
      const finish = () => {
        if (done) return;
        done = true;
        cleanup();
        resolve();
      };
      const finishListener = () => {
        appendLog('Sinal de finalização da roleta recebido.', 'fs-remote');
        finish();
      };
      window.addEventListener('roulette:finished', finishListener, { once: true });

      appendLog('Acionando roleta...', 'fs-remote');
      triggerEvent('pointerdown');

      releaseTimer = setTimeout(() => {
        triggerEvent('pointerup');
        appendLog('Roleta girando...');
      }, 3000);

      failSafeTimer = setTimeout(() => {
        appendLog('Roleta: finalização não detectada (timeout).', 'fs-remote');
        finish();
      }, 12000);
    });
  }
  async function fireDelta(delta){
    if (!S.armed) {
      appendLog(`Ignorado (desarmado): ${delta}pts`, 'fs-remote');
      return;
    }

    const mode = (currentMode() || '').toUpperCase();
    const isRoulette = mode === 'ROULETTE';

    if (isRoulette) {
      appendLog(`Modo roleta (maincontrol): ${delta} giro(s)`, 'fs-remote');
      for (let i = 0; i < delta; i++) {
        await spinRouletteOnce();
        if (i < delta - 1) await delay(S.gapMs);
      }
      return;
    }

    appendLog(`Modo padrão: ${delta}pts`, 'fs-remote');
    for (const v of decompose(delta)){
      await fireProfile(v);
      await delay(S.gapMs);
    }
  }

  function whichSide(target, snap){
    const t = norm(target);
    if (S.anySide) return 'any';
    // sem alvo definido => ignora disparo
    if (!t) return null;
    if (norm(snap.homeName).includes(t)) return 'home';
    if (norm(snap.awayName).includes(t)) return 'away';
    return null;
  }

  function sideFromEvent(ev){
    const rawSide = String(ev?.side || ev?.teamSide || ev?.team || '').toLowerCase();
    if (['home','casa'].includes(rawSide)) return 'home';
    if (['away','visitor','visitante','fora'].includes(rawSide)) return 'away';
    return null;
  }

  function ruleTypeFromEvent(ev){
    const raw = norm(ev?.type || ev?.event || ev?.card || ev?.kind || '');
    if (raw.includes('red') || raw.includes('vermelho')) return 'redCard';
    if (raw.includes('yellow') || raw.includes('amarelo')) return 'yellowCard';
    if (raw.includes('substitution') || raw.includes('substituicao')) return 'substitution';
    return null;
  }

  function extractRuleEvents(payload){
    const lists = [payload?.cards, payload?.events, payload?.cardEvents].filter(Array.isArray);
    const out = [];
    lists.forEach((list)=>{
      list.forEach((ev)=>{
        const side = sideFromEvent(ev);
        const type = ruleTypeFromEvent(ev);
        if (side && type) out.push({
          side,
          type,
          id: ev.id || ev.ts || ev.minute || `${side}:${type}`,
          minute: ev.minute || '',
          player: ev.player || '',
          playerOut: ev.playerOut || ''
        });
      });
    });
    return out;
  }

  function handleScore(payload, opts = {}){
    if (!payload || typeof payload !== 'object') return;
    const src = payload.origin || payload.peerId || 'fs-remote';
    const ts = Number.isFinite(payload.ts) ? payload.ts : (payload.ts ? Number(payload.ts) : Date.now());
    const key = `${src}:${ts || '0'}`;
    if (seenScore.has(key)) return;
    seenScore.add(key);
    const prevSnap = lastSnap;
    const statusText = String(payload.statusText || payload.matchStatus || payload.status || '').trim();
    const endedByStatus = /(encerr|final|finished|termin|ended|\bft\b|fim)/i.test(statusText);
    const cardEvents = extractRuleEvents(payload);
    const snap = {
      homeName: payload.homeName || '',
      awayName: payload.awayName || '',
      homeScore: Number.isFinite(payload.homeScore) ? payload.homeScore : null,
      awayScore: Number.isFinite(payload.awayScore) ? payload.awayScore : null,
      statusText,
      matchStatus: String(payload.matchStatus || statusText).trim(),
      ended: payload.ended === true || endedByStatus,
      ts,
      origin: src,
      reason: payload.reason || 'update',
      cards: cardEvents
    };
    const cardSnapshot = cardEvents.map((ev)=>`${ev.side}:${ev.type}:${ev.id}`).join('|');
    const hash = JSON.stringify([snap.homeName, snap.awayName, snap.homeScore, snap.awayScore, snap.ended, snap.matchStatus, cardSnapshot]);
    if (hash === lastScoreHash && ts <= lastScoreTs) return;
    lastScoreHash = hash; lastScoreTs = ts;
    appendLog(`${snap.homeName || 'Casa'} ${Number.isFinite(snap.homeScore) ? snap.homeScore : '-'} x ${Number.isFinite(snap.awayScore) ? snap.awayScore : '-'} ${snap.awayName || 'Fora'} (${payload.reason || 'update'})`, src);

    try {
      window.dispatchEvent(new CustomEvent('fs-score:local', { detail: { payload: snap, peerId: payload.origin || 'fs-remote' } }));
    } catch(_){ }
    // also publish via cross-document bus so mirrors in other documents receive it
    try { if (window.__FS_BUS__ && typeof window.__FS_BUS__.send === 'function') window.__FS_BUS__.send({ type:'fs-score', payload: snap, peerId: payload.origin || 'fs-remote' }); } catch(_){ }
    // If Flashscore reached only this host document via iframe/postMessage, promote it to the P2P room.
    if (!opts.fromRoom) relayScoreToRoom(snap, payload);

    const isFirstOrSwapped = !prevSnap || snap.homeName !== prevSnap.homeName || snap.awayName !== prevSnap.awayName;
    lastSnap = snap;
    syncInputs();
    if (isFirstOrSwapped) {
      cardEvents.forEach((ev)=> seenCardEvents.add(`${snap.homeName}|${snap.awayName}|${ev.side}|${ev.type}|${ev.id}`));
      return;
    }

    const dHome = (Number.isInteger(snap.homeScore) && Number.isInteger(prevSnap.homeScore) && snap.homeScore > prevSnap.homeScore)
      ? (snap.homeScore - prevSnap.homeScore) : 0;
    const dAway = (Number.isInteger(snap.awayScore) && Number.isInteger(prevSnap.awayScore) && snap.awayScore > prevSnap.awayScore)
      ? (snap.awayScore - prevSnap.awayScore) : 0;

    if (S.triggerMode === 'rules') {
      for (let i = 0; i < dHome; i++) {
        appendReceivedEvent('goal', 'home', `${snap.homeName || 'Casa'} +1`);
        enqueue(()=> fireRule('home', 'goal'));
      }
      for (let i = 0; i < dAway; i++) {
        appendReceivedEvent('goal', 'away', `${snap.awayName || 'Visitante'} +1`);
        enqueue(()=> fireRule('away', 'goal'));
      }
      cardEvents.forEach((ev)=>{
        const cardKey = `${snap.homeName}|${snap.awayName}|${ev.side}|${ev.type}|${ev.id}`;
        if (seenCardEvents.has(cardKey)) return;
        seenCardEvents.add(cardKey);
        const detail = [ev.minute, ev.player, ev.playerOut ? `sai ${ev.playerOut}` : ''].filter(Boolean).join(' - ');
        appendReceivedEvent(ev.type, ev.side, detail);
        enqueue(()=> fireRule(ev.side, ev.type));
      });
      if (snap.ended && !prevSnap.ended && Number.isInteger(snap.homeScore) && Number.isInteger(snap.awayScore)) {
        if (snap.homeScore === snap.awayScore) {
          appendReceivedEvent('draw', 'any', 'fim de jogo');
          enqueue(()=> fireResultRule('draw', 'any'));
        } else {
          const homeWon = snap.homeScore > snap.awayScore;
          const winnerSide = homeWon ? 'home' : 'away';
          const loserSide = homeWon ? 'away' : 'home';
          appendReceivedEvent('winner', winnerSide, 'fim de jogo');
          appendReceivedEvent('loser', loserSide, 'fim de jogo');
          enqueue(()=> fireResultRule('winner', winnerSide));
          enqueue(()=> fireResultRule('loser', loserSide));
        }
      }
      return;
    }

    const side = whichSide(S.team, snap);
    if (!side) return;

    if (S.anySide){
      const total = dHome + dAway;
      if (total > 0) enqueue(()=> fireDelta(total));
    } else if (side === 'home' && dHome > 0){
      enqueue(()=> fireDelta(dHome));
    } else if (side === 'away' && dAway > 0){
      enqueue(()=> fireDelta(dAway));
    }
  }

  function triggerTestPoint(side) {
    if (!lastSnap) {
        appendLog('Sem placar para adicionar ponto de teste.', 'fs-remote');
        return;
    }

    const newPayload = { ...lastSnap, ts: Date.now(), reason: 'test-point', origin: 'local-test' };

    if (side === 'home') {
        newPayload.homeScore = (lastSnap.homeScore || 0) + 1;
    } else {
        newPayload.awayScore = (lastSnap.awayScore || 0) + 1;
    }

    handleScore(newPayload);
  }

