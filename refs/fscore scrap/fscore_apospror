  const delay = (ms)=> new Promise(r=> setTimeout(r, ms));

  function currentMode(){
    const btn = document.querySelector('.mode-btn.active');
    if (btn?.dataset?.mode) return btn.dataset.mode;
    return S.mode || 'SHOCK';
  }

  async function pulseOnce(level, dur){
    const lvl = clamp(Math.round(level),0,100);
    const mode = currentMode();
    await sendCommand(`HOLDON ${mode},${lvl},${S.channel}`);
    await delay(dur);
    await sendCommand('HOLDOFF');
  }

  async function fireProfile(points){
    const pf = S.profiles[points] || S.profiles[1];
    const level = clamp(S.level * (pf.lvlMul||1), 0, 100);
    const dur   = Math.max(1, Math.round(S.baseMs * (pf.durMul||1)));

    for (let i=0;i<(pf.pulses||1);i++){
      await pulseOnce(level, dur);
      if (i<(pf.pulses||1)-1) await delay(S.gapMs);
    }
  }

  function supportsLevel(mode){
    const key = String(mode || '').toUpperCase();
    return key === 'SHOCK' || key === 'VIBRATION';
  }

  function commandLevelForRule(rule){
    return clamp(parseInt(rule?.level, 10) || 0, 0, 100);
  }

  async function pulseRule(rule){
    const mode = String(rule?.mode || 'SHOCK').toUpperCase();
    const channel = clamp(parseInt(rule?.channel, 10) || 1, 1, 2);
    const duration = Math.max(1, parseInt(rule?.durationMs, 10) || 300);
    const level = supportsLevel(mode) ? commandLevelForRule(rule) : 0;
    await sendCommand(`HOLDON ${mode},${level},${channel}`);
    await delay(duration);
    await sendCommand('HOLDOFF');
  }

  async function fireRule(side, eventKey){
    if (!S.armed) {
      appendLog(`Ignorado (desarmado): ${side}/${eventKey}`, 'fs-remote');
      return;
    }
    const rule = S.rules?.[side]?.[eventKey];
    if (!rule || !rule.enabled) return;
    const mode = String(rule.mode || '').toUpperCase();
    const pulses = Math.max(1, parseInt(rule.pulses, 10) || 1);
    const gap = Math.max(0, parseInt(rule.gapMs, 10) || 0);
    appendLog(`Regra ${side}/${eventKey}: ${mode || 'SHOCK'} x${pulses}`, 'fs-remote');
    if (mode === 'ROULETTE') {
      for (let i = 0; i < pulses; i++) {
        await spinRouletteOnce();
        if (i < pulses - 1) await delay(gap);
      }
      return;
    }
    for (let i = 0; i < pulses; i++) {
      await pulseRule(rule);
      if (i < pulses - 1) await delay(gap);
    }
  }

  function resultTargetMatches(rule, sideKey, eventKey){
    const target = String(rule?.target || 'any').toLowerCase();
    if (eventKey === 'draw') return sideKey === 'any';
    if (!['winner','loser'].includes(eventKey)) return false;
    if (target === 'any') return false;
    return target === sideKey;
  }

  function labelForTargetSide(sideKey){
    if (sideKey === 'home') return lastSnap?.homeName || 'Casa';
    if (sideKey === 'away') return lastSnap?.awayName || 'Visitante';
