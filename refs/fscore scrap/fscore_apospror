  const FS_RULE_EVENTS = [
    { key:'goal', label:'Ponto' },
    { key:'redCard', label:'Cartao vermelho' },
    { key:'yellowCard', label:'Cartao amarelo' },
    { key:'substitution', label:'Substituicao' }
  ];
  const FS_RESULT_EVENTS = [
    { key:'winner', label:'Vencedor' },
    { key:'loser', label:'Perdedor' },
    { key:'draw', label:'Empate' }
