    const label = FS_RESULT_EVENTS.some((ev)=>ev.key === eventKey) ? labelForResultEvent(eventKey) : labelForEvent(eventKey);
    recentRuleEvents.push({
      eventKey,
      sideKey,
      label,
      sideLabel: labelForTargetSide(sideKey),
      detail: String(detail || '').trim(),
      ts: Date.now()
