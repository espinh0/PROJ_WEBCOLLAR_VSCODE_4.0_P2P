  }

  function iconForMode(mode){
    const key = String(mode || '').toUpperCase();
    if (key === 'SHOCK') return 'fa-solid fa-bolt-lightning';
    if (key === 'VIBRATION') return 'fa-solid fa-mobile-screen-button';
    if (key === 'LIGHT') return 'fa-solid fa-lightbulb';
    if (key === 'BEEP') return 'fa-solid fa-volume-high';
    if (key === 'ROULETTE') return 'fa-solid fa-dice';
    return 'fa-solid fa-circle';
  }

  function formatSeconds(value){
    const num = Number(value);
    if (!Number.isFinite(num)) return '0s';
    return `${Number.isInteger(num) ? String(num) : num.toFixed(1).replace(/\.0$/, '')}s`;
  }

  function renderActiveRules(){
    const wrap = inputs.activeRules;
    const list = inputs.activeRulesList;
    if (!wrap || !list) return;
    list.innerHTML = '';
    const activeBySide = {};
    FS_RULE_SIDES.forEach((side)=>{ activeBySide[side.key] = []; });
    const activeResults = [];
    if (S.triggerMode === 'rules') {
      FS_RULE_SIDES.forEach((side)=>{
        FS_RULE_EVENTS.forEach((ev)=>{
          const rule = S.rules?.[side.key]?.[ev.key];
          if (rule?.enabled) activeBySide[side.key].push({ event: ev.key, rule });
        });
      });
      FS_RESULT_EVENTS.forEach((ev)=>{
        const rule = S.resultRules?.[ev.key];
        if (rule?.enabled) activeResults.push({ event: ev.key, rule });
      });
    }
    const hasSideActive = Object.values(activeBySide).some((items)=> items.length > 0);
    const hasActive = hasSideActive || activeResults.length > 0;
    wrap.classList.toggle('d-none', !hasActive);
    if (!hasActive) return;

    if (hasSideActive) FS_RULE_SIDES.forEach((side)=>{
      const col = document.createElement('div');
      col.className = 'fsm-active-rules-side';
      col.dataset.side = side.key;

      const title = document.createElement('div');
      title.className = 'fsm-active-rules-title';
      title.textContent = labelForSide(side.key);
      col.appendChild(title);

      const items = activeBySide[side.key];
      if (!items.length) {
        const empty = document.createElement('div');
        empty.className = 'fsm-active-rule-empty';
        empty.textContent = 'Nenhuma regra ativa';
        col.appendChild(empty);
      }

      items.forEach((item)=>{
        const row = document.createElement('div');
        row.className = 'fsm-active-rule-row';
        const rule = item.rule;
        const mode = String(rule.mode || 'SHOCK').toUpperCase();
        const level = supportsLevel(mode) ? `${commandLevelForRule(rule)}%` : '0%';
        const eventLabel = document.createElement('span');
        eventLabel.className = 'fsm-active-rule-event';
        fillEventLabelNode(eventLabel, item.event, `${labelForEvent(item.event)}:`);
        const icon = document.createElement('i');
        icon.className = iconForMode(mode);
        icon.setAttribute('aria-hidden', 'true');
        const detail = document.createElement('span');
        const pulses = Math.max(1, parseInt(rule.pulses, 10) || 1);
        const channel = clamp(parseInt(rule.channel, 10) || 1, 1, 2);
        const durationSec = Math.max(0.1, (parseInt(rule.durationMs, 10) || DEFAULT_RULE.durationMs) / 1000);
        detail.textContent = `${pulses}x ${mode} ${level} no C${channel} por ${formatSeconds(durationSec)}`;
        row.append(eventLabel, icon, detail);
        col.appendChild(row);
      });

      list.appendChild(col);
    });

    if (activeResults.length) {
      const resultCol = document.createElement('div');
      resultCol.className = 'fsm-active-rules-side fsm-active-rules-result';
      const title = document.createElement('div');
      title.className = 'fsm-active-rules-title';
      title.textContent = 'Resultado final';
      resultCol.appendChild(title);
      activeResults.forEach((item)=>{
        const row = document.createElement('div');
        row.className = 'fsm-active-rule-row';
        const rule = item.rule;
        const mode = String(rule.mode || 'SHOCK').toUpperCase();
        const level = supportsLevel(mode) ? `${commandLevelForRule(rule)}%` : '0%';
        const eventLabel = document.createElement('span');
        eventLabel.className = 'fsm-active-rule-event';
        fillEventLabelNode(eventLabel, item.event, `${labelForResultEvent(item.event)} (${labelForResultTarget(rule.target)}):`);
        const icon = document.createElement('i');
        icon.className = iconForMode(mode);
        icon.setAttribute('aria-hidden', 'true');
        const detail = document.createElement('span');
        const pulses = Math.max(1, parseInt(rule.pulses, 10) || 1);
        const channel = clamp(parseInt(rule.channel, 10) || 1, 1, 2);
        const durationSec = Math.max(0.1, (parseInt(rule.durationMs, 10) || DEFAULT_RULE.durationMs) / 1000);
        detail.textContent = `${pulses}x ${mode} ${level} no C${channel} por ${formatSeconds(durationSec)}`;
        row.append(eventLabel, icon, detail);
        resultCol.appendChild(row);
      });
      list.appendChild(resultCol);
    }
  }

  function syncRuleRefs(refs, rule){
    if (!refs) return;
    const currentRule = rule || cloneRule();
    if (refs.enabled) refs.enabled.checked = !!currentRule.enabled;
    if (refs.fields) refs.fields.classList.toggle('is-hidden', !currentRule.enabled);
    if (refs.target) {
      const homeOpt = refs.target.querySelector('option[value="home"]');
      const awayOpt = refs.target.querySelector('option[value="away"]');
      if (homeOpt) homeOpt.textContent = lastSnap?.homeName || 'Casa';
      if (awayOpt) awayOpt.textContent = lastSnap?.awayName || 'Visitante';
      refs.target.value = ['home','away'].includes(currentRule.target) ? currentRule.target : 'home';
    }
    if (refs.mode) refs.mode.value = currentRule.mode ?? DEFAULT_RULE.mode;
    const levelValue = clamp(parseInt(currentRule.level, 10) || 0, 0, 100);
    if (refs.level) {
      refs.level.value = levelValue;
      refs.level.style.setProperty('--lvl', `${levelValue}%`);
    }
    if (refs.levelValue) refs.levelValue.textContent = `${levelValue}%`;
    if (refs.channel) refs.channel.checked = (clamp(parseInt(currentRule.channel, 10) || 1, 1, 2) === 2);
    if (refs.channelValue) refs.channelValue.textContent = String(clamp(parseInt(currentRule.channel, 10) || 1, 1, 2));
    if (refs.pulses) refs.pulses.value = currentRule.pulses ?? DEFAULT_RULE.pulses;
    if (refs.durationMs) {
      const seconds = Math.max(0.1, (parseInt(currentRule.durationMs, 10) || DEFAULT_RULE.durationMs) / 1000);
      refs.durationMs.value = Number.isInteger(seconds) ? String(seconds) : seconds.toFixed(1).replace(/\.0$/, '');
    }
    if (refs.gapMs) refs.gapMs.value = currentRule.gapMs ?? DEFAULT_RULE.gapMs;
  }

  function syncInputs(){
    if (inputs.armed) inputs.armed.checked = !!S.armed;
    const triggerMode = S.triggerMode === 'profiles' ? 'profiles' : 'rules';
    if (inputs.triggerRules) inputs.triggerRules.checked = triggerMode === 'rules';
    if (inputs.triggerProfiles) inputs.triggerProfiles.checked = triggerMode === 'profiles';
    if (inputs.rulesPanel) inputs.rulesPanel.classList.toggle('is-hidden', triggerMode !== 'rules');
    if (inputs.profilePanel) inputs.profilePanel.classList.toggle('is-hidden', triggerMode !== 'profiles');
    if (inputs.globalDelay) {
      const seconds = Math.max(0, (parseInt(S.preDelayMs, 10) || 0) / 1000);
      inputs.globalDelay.value = Number.isInteger(seconds) ? String(seconds) : seconds.toFixed(1).replace(/\.0$/, '');
    }
    try { window.__FS_SCORE_MIRROR__?.refreshTargetButtons?.(); } catch(_){}
    FS_RULE_SIDES.forEach((side)=>{
      const teamName = side.key === 'home' ? (lastSnap?.homeName || 'Casa') : (lastSnap?.awayName || 'Visitante');
      const teamNameEl = $(`fsr-rule-${side.key}-team-name`);
      if (teamNameEl) teamNameEl.textContent = teamName;
      FS_RULE_EVENTS.forEach((ev)=>{
        const rule = S.rules?.[side.key]?.[ev.key] || cloneRule();
        const refs = inputs.rules?.[side.key]?.[ev.key];
        syncRuleRefs(refs, rule);
      });
    });
    FS_RESULT_EVENTS.forEach((ev)=>{
      syncRuleRefs(inputs.resultRules?.[ev.key], S.resultRules?.[ev.key] || cloneRule());
    });
    [1,2,3].forEach((p)=>{
      const pf = S.profiles[p];
      const refs = inputs[`p${p}`];
      if (!pf || !refs) return;
      if (refs.pulses) refs.pulses.value = pf.pulses ?? '';
      if (refs.lvl) refs.lvl.value = pf.lvlMul ?? '';
      if (refs.dur) refs.dur.value = pf.durMul ?? '';
    });
    // preview
    if (preview.armed) {
      preview.armed.textContent = S.armed ? 'armado' : 'desarmado';
      preview.armed.className = S.armed ? 'badge text-bg-success' : 'badge text-bg-dark';
    }
    if (preview.mode) preview.mode.textContent = S.mode || '-';
    if (preview.level) preview.level.textContent = S.level ?? '-';
    if (preview.chan) preview.chan.textContent = S.channel ?? '-';
    if (preview.gap) preview.gap.textContent = S.gapMs ? `${S.gapMs}ms` : '-';
    if (preview.base) preview.base.textContent = S.baseMs ? `${S.baseMs}ms` : '-';
    if (preview.preDelay) preview.preDelay.textContent = S.preDelayMs ? `${S.preDelayMs}ms` : '0ms';
    renderActiveRules();
  }
  function syncMirrorTargetFromState(){
    try{
      const mirror = window.__FS_SCORE_MIRROR__;
      if (!mirror || typeof mirror.setActiveTarget !== 'function') return;
      if (S?.triggerMode !== 'profiles') {
        mirror.setActiveTarget(null);
        return;
      }
      const fallback = typeof mirror.getCurrentTargetKey === 'function' ? mirror.getCurrentTargetKey() : 'any';
      const side = S?.anySide ? 'any' : (S?.side || fallback);
      mirror.setActiveTarget(side);
    } catch(_){}
  }
  syncInputs();
  syncMirrorTargetFromState();

  function controlSnapshot(includeTarget = false, includeProfiles = true){
    const base = {
      armed: S.armed,
      triggerMode: S.triggerMode,
      mode: S.mode,
      level: S.level,
      channel: S.channel,
      gapMs: S.gapMs,
      baseMs: S.baseMs,
      preDelayMs: S.preDelayMs
    };
    if (includeTarget) {
      base.team = S.team;
      base.anySide = S.anySide;
      base.side = S.anySide ? 'any' : (S.side || 'home');
    }
    if (includeProfiles) base.profiles = S.profiles;
    base.rules = S.rules;
    base.resultRules = S.resultRules;
    return base;
  }

  function broadcastConfig(reason, opts = {}){
    const includeTarget = opts.includeTarget === true;
    const includeProfiles = opts.includeProfiles !== false;
    const ts = Date.now();
    const payload = { ...controlSnapshot(includeTarget, includeProfiles), reason: reason || 'change', ts, origin: SELF_ID };
    markTsFromPayload(payload, ts);
    if (sendConfig) {
      try { sendConfig(payload); } catch(_){}
    }
    if (opts.toBus !== false && window.__FS_BUS__ && typeof window.__FS_BUS__.send === 'function') {
      const busPayload = { ...payload };
      delete busPayload.profiles; // não enviar multiplicadores ao controle remoto
      try { window.__FS_BUS__.send({ type:'fs-control', payload: busPayload }); } catch(_){}
    }
  }

  function relayControlPayload(payload, opts = {}){
    if (!payload || typeof payload !== 'object') return;
    if (!shouldRelayPayload(payload)) return;
    const toBus = opts.toBus !== false;
    const toRoom = opts.toRoom !== false;
    // preserva ts/origin do remetente
    if (toRoom && sendConfig) {
      try { sendConfig(payload); } catch(_){}
    }
    if (toBus && window.__FS_BUS__ && typeof window.__FS_BUS__.send === 'function') {
      const busPayload = { ...payload };
      delete busPayload.profiles; // bus para controle remoto sem multiplicadores
      try { window.__FS_BUS__.send({ type:'fs-control', payload: busPayload }); } catch(_){}
    }
  }

  function attachSliderTooltip(el, formatter){
    if (!el) return;
    const fmt = formatter || (v=>v);
    const update = ()=>{
      const val = el.value;
      const txt = fmt(val);
      el.setAttribute('title', txt);
      el.setAttribute('data-bs-original-title', txt);
    };
    el.addEventListener('input', update);
    setTimeout(update, 0);
  }

  function bindInputs(){
    if (inputs.armed) inputs.armed.addEventListener('change', (e)=>{ S.armed = !!e.target.checked; saveState(); broadcastConfig('armed'); syncInputs(); });
    [inputs.triggerRules, inputs.triggerProfiles].forEach((el)=>{
      if (!el) return;
      el.addEventListener('change', (e)=>{
        if (!e.target.checked) return;
        S.triggerMode = e.target.value === 'profiles' ? 'profiles' : 'rules';
        saveState();
        broadcastConfig('trigger-mode');
        syncInputs();
        syncMirrorTargetFromState();
      });
    });
    inputs.globalDelay?.addEventListener('change', (e)=>{
      const seconds = Math.max(0, parseFloat(e.target.value) || 0);
      S.preDelayMs = Math.round(seconds * 1000);
      e.target.value = Number.isInteger(seconds) ? String(seconds) : seconds.toFixed(1).replace(/\.0$/, '');
      saveState();
      broadcastConfig('global-delay');
      syncInputs();
    });

    FS_RULE_SIDES.forEach((side)=>{
      FS_RULE_EVENTS.forEach((ev)=>{
        const refs = inputs.rules?.[side.key]?.[ev.key];
        if (!refs) return;
        const ensureRule = ()=> {
          S.rules = normalizeRules(S.rules);
          return S.rules[side.key][ev.key];
        };
        refs.enabled?.addEventListener('change', (e)=>{
          const rule = ensureRule();
          rule.enabled = !!e.target.checked;
          saveState();
          broadcastConfig('rule-change');
          syncInputs();
        });
        refs.mode?.addEventListener('change', (e)=>{
          const rule = ensureRule();
          rule.mode = String(e.target.value || 'SHOCK').toUpperCase();
          saveState();
          broadcastConfig('rule-change');
          renderActiveRules();
        });
        refs.level?.addEventListener('input', (e)=>{
          const rule = ensureRule();
          rule.level = clamp(parseInt(e.target.value, 10) || 0, 0, 100);
          e.target.value = rule.level;
          e.target.style.setProperty('--lvl', `${rule.level}%`);
          if (refs.levelValue) refs.levelValue.textContent = `${rule.level}%`;
          saveState();
          broadcastConfig('rule-change');
          renderActiveRules();
        });
        refs.channel?.addEventListener('change', (e)=>{
          const rule = ensureRule();
          rule.channel = e.target.checked ? 2 : 1;
          if (refs.channelValue) refs.channelValue.textContent = String(rule.channel);
          saveState();
          broadcastConfig('rule-change');
          renderActiveRules();
        });
        refs.pulses?.addEventListener('change', (e)=>{
          const rule = ensureRule();
          rule.pulses = clamp(parseInt(e.target.value, 10) || 1, 1, 20);
          e.target.value = rule.pulses;
          saveState();
          broadcastConfig('rule-change');
          renderActiveRules();
        });
        refs.durationMs?.addEventListener('change', (e)=>{
          const rule = ensureRule();
          const seconds = Math.max(0.1, parseFloat(e.target.value) || 0.1);
          rule.durationMs = Math.round(seconds * 1000);
          e.target.value = Number.isInteger(seconds) ? String(seconds) : seconds.toFixed(1).replace(/\.0$/, '');
          saveState();
          broadcastConfig('rule-change');
          renderActiveRules();
        });
        refs.gapMs?.addEventListener('change', (e)=>{
          const rule = ensureRule();
          rule.gapMs = Math.max(0, parseInt(e.target.value, 10) || 0);
          e.target.value = rule.gapMs;
          saveState();
          broadcastConfig('rule-change');
          renderActiveRules();
        });
        refs.test?.addEventListener('click', ()=> enqueue(()=> fireRule(side.key, ev.key)));
      });
    });

    FS_RESULT_EVENTS.forEach((ev)=>{
      const refs = inputs.resultRules?.[ev.key];
      if (!refs) return;
      const ensureRule = ()=> {
        S.resultRules = normalizeResultRules(S.resultRules, S.rules);
        return S.resultRules[ev.key];
      };
      refs.enabled?.addEventListener('change', (e)=>{
        const rule = ensureRule();
        rule.enabled = !!e.target.checked;
        saveState();
        broadcastConfig('result-rule-change');
        syncInputs();
      });
      refs.target?.addEventListener('change', (e)=>{
        const rule = ensureRule();
        const target = String(e.target.value || 'home').toLowerCase();
        rule.target = ['home','away'].includes(target) ? target : 'home';
        e.target.value = rule.target;
        saveState();
        broadcastConfig('result-rule-change');
        renderActiveRules();
      });
      refs.mode?.addEventListener('change', (e)=>{
        const rule = ensureRule();
        rule.mode = String(e.target.value || 'SHOCK').toUpperCase();
        saveState();
        broadcastConfig('result-rule-change');
        renderActiveRules();
      });
      refs.level?.addEventListener('input', (e)=>{
        const rule = ensureRule();
        rule.level = clamp(parseInt(e.target.value, 10) || 0, 0, 100);
        e.target.value = rule.level;
        e.target.style.setProperty('--lvl', `${rule.level}%`);
        if (refs.levelValue) refs.levelValue.textContent = `${rule.level}%`;
        saveState();
        broadcastConfig('result-rule-change');
        renderActiveRules();
      });
      refs.channel?.addEventListener('change', (e)=>{
        const rule = ensureRule();
        rule.channel = e.target.checked ? 2 : 1;
        if (refs.channelValue) refs.channelValue.textContent = String(rule.channel);
        saveState();
        broadcastConfig('result-rule-change');
        renderActiveRules();
      });
      refs.pulses?.addEventListener('change', (e)=>{
        const rule = ensureRule();
        rule.pulses = clamp(parseInt(e.target.value, 10) || 1, 1, 20);
        e.target.value = rule.pulses;
        saveState();
        broadcastConfig('result-rule-change');
        renderActiveRules();
      });
      refs.durationMs?.addEventListener('change', (e)=>{
        const rule = ensureRule();
        const seconds = Math.max(0.1, parseFloat(e.target.value) || 0.1);
        rule.durationMs = Math.round(seconds * 1000);
        e.target.value = Number.isInteger(seconds) ? String(seconds) : seconds.toFixed(1).replace(/\.0$/, '');
        saveState();
        broadcastConfig('result-rule-change');
        renderActiveRules();
      });
      refs.gapMs?.addEventListener('change', (e)=>{
        const rule = ensureRule();
        rule.gapMs = Math.max(0, parseInt(e.target.value, 10) || 0);
        e.target.value = rule.gapMs;
        saveState();
        broadcastConfig('result-rule-change');
        renderActiveRules();
