  function labelForSide(sideKey){
    const side = FS_RULE_SIDES.find((item)=> item.key === sideKey);
    if (!side) return sideKey;
    if (sideKey === 'home') return lastSnap?.homeName || 'Casa';
    if (sideKey === 'away') return lastSnap?.awayName || 'Visitante';
    return side.label;
  }

  function labelForEvent(eventKey){
    const labels = {
      goal: 'PONTO',
      redCard: 'CART\u00c3O VERMELHO',
      yellowCard: 'CART\u00c3O AMARELO',
      substitution: 'SUBSTITUI\u00c7\u00c3O'
    };
    return labels[eventKey] || String(FS_RULE_EVENTS.find((item)=> item.key === eventKey)?.label || eventKey).toUpperCase();
  }

  function labelForResultEvent(eventKey){
    const labels = {
      winner: 'VENCEDOR',
      loser: 'PERDEDOR',
      draw: 'EMPATE'
    };
    return labels[eventKey] || String(FS_RESULT_EVENTS.find((item)=> item.key === eventKey)?.label || eventKey).toUpperCase();
  }

  function labelForResultTarget(targetKey){
    if (targetKey === 'home') return (lastSnap?.homeName || 'Casa').toUpperCase();
    if (targetKey === 'away') return (lastSnap?.awayName || 'Visitante').toUpperCase();
