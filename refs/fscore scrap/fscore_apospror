  async function sendCommand(line){
    const txt = String(line||'').trim();
    if (!txt) return;
    if (!isHost()) { console.warn('ignorado: comandos so em host'); return; }
    const emitEcho = () => {
      try { window.dispatchEvent(new CustomEvent('collar:echo', { detail: { line: txt, source: 'fscore' } })); } catch(_){ }
    };
    const central = window.__COLLAR_COMMAND_API__;
    if (central && typeof central.send === 'function') {
      try {
        await central.send(txt, { source: 'fscore' });
        emitEcho();
        return;
      } catch(e){ console.warn('falha command API', e); }
    }
