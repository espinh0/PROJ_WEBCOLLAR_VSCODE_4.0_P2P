    [1,2,3].forEach((p)=>{
      const refs = inputs[`p${p}`];
      if (!refs) return;
      refs.pulses?.addEventListener('change', (e)=>{
        const pf = S.profiles[p] || (S.profiles[p] = {pulses:1,lvlMul:1,durMul:1});
        pf.pulses = Math.max(1, parseInt(e.target.value,10)||1);
